# Cấu hình trợ lý AI trên web Planning. Chép thành .env.ai (đã nằm trong .gitignore) rồi điền.
# KHÔNG ghi hai dòng này vào .env: repo công khai và .env đang được commit.
# Hướng dẫn: docs/TRO-LY-AI.md

# Khoá ký token, phải giống hệt WEB_AI_SECRET của dịch vụ trợ lý. Nhận từ nhóm AI P.CNTT qua kênh riêng.
WEB_AI_SECRET=

# Địa chỉ HTTPS của dịch vụ trợ lý (máy người dùng trong LAN phải mở được), không có "/" ở cuối.
WEB_AI_API=https://mcp.hoaphatdungquat.vn/web
